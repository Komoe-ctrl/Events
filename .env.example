# URL de base de l'API (prefixe /api inclus). La valeur depend de la cible :
# - Emulateur Android : http://10.0.2.2:3000/api
#   10.0.2.2 est l'alias reseau que l'emulateur Android fournit pour joindre
#   le "localhost" de la machine hote. "localhost" depuis l'emulateur pointe
#   vers l'emulateur lui-meme, pas vers votre machine — l'API n'y repond pas.
# - Telephone physique, sur le meme reseau Wi-Fi que le poste de dev :
#   l'adresse IP locale du poste, ex. http://192.168.1.42:3000/api
#   (ni localhost ni 10.0.2.2 ne sont joignables depuis un appareil externe)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
